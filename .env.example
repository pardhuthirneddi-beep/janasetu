# Managed runtime supplies DATABASE_URL for the MySQL-compatible database.
# Do not check real credentials into the repository.
DATABASE_URL=
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=
MANUS_API_URL=
MANUS_API_KEY=
# Optional strict callback-origin allowlist; the browser still supplies its actual origin.
PUBLIC_APP_ORIGIN=
API_PORT=8000
